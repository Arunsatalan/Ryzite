// ==========================================
// AEO & COMPANY FACTS ENTITY KNOWLEDGE HUB
// ==========================================

enum FactVerifiedStatus {
  UNVERIFIED
  VERIFIED
  EXPIRED
  REQUIRES_REVIEW
}

enum FactCategory {
  COMPANY
  SERVICES
  TECHNOLOGY
  INDUSTRIES
  PROCESS
  PRICING
  LOCATIONS
  CLIENTS
  PROJECTS
  TEAM
  SECURITY
  SUPPORT
  CONTACT
  POLICIES
}

enum ClaimType {
  FACTUAL
  MARKETING
  ESTIMATE
  TESTIMONIAL
  CASE_STUDY_RESULT
  INTERNAL
}

enum AuditSeverity {
  CRITICAL
  WARNING
  INFO
}

model CompanyEntity {
  id                 String   @id @default(uuid())
  entityId           String   @default("https://ryzite.com/#organization")
  entityType         String   @default("Organization")
  legalName          String   @default("Ryzite Global Software Inc.")
  tradingName        String   @default("Ryzite")
  shortDescription   String   @db.Text
  longDescription    String   @db.Text
  companyType        String   @default("Software Development Agency")
  industry           String   @default("Software Engineering & AI")
  foundedYear        Int      @default(2022)
  canonicalUrl       String   @default("https://ryzite.com/")
  logoUrl            String?
  logoPublicId       String?
  email              String   @default("contact@ryzite.com")
  phone              String?
  primaryCountry     String   @default("USA")
  headquarters       String   @default("San Francisco, CA")
  serviceAreas       String[] @default(["United States", "Global", "North America", "Europe"])
  languages          String[] @default(["English"])
  sameAs             String[]
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CompanyFact {
  id              String             @id @default(uuid())
  category        FactCategory       @default(COMPANY)
  claimType       ClaimType          @default(FACTUAL)
  question        String
  shortAnswer     String             @db.Text
  detailedAnswer  String             @db.Text
  sourceUrl       String?
  sourceType      String?            @default("Official Website")
  evidenceNote    String?            @db.Text
  verifiedStatus  FactVerifiedStatus @default(VERIFIED)
  verifiedBy      String?            @default("Managing Architect")
  verifiedAt      DateTime?          @default(now())
  reviewDate      DateTime?
  expirationDate  DateTime?
  status          StatisticStatus    @default(PUBLISHED)
  priority        Int                @default(1)
  displayOrder    Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  versions        CompanyFactVersion[]
  evidence        CompanyEvidence[]

  @@index([status, category, priority])
  @@index([verifiedStatus])
}

model CompanyFactVersion {
  id          String      @id @default(uuid())
  factId      String
  fact        CompanyFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  oldValue    Json
  newValue    Json
  changedBy   String      @default("Admin System")
  reason      String?
  createdAt   DateTime    @default(now())

  @@index([factId, createdAt])
}

model CompanyFaq {
  id              String          @id @default(uuid())
  question        String
  shortAnswer     String          @db.Text
  detailedAnswer  String          @db.Text
  relatedServiceId String?
  relatedPage     String?
  evidenceUrl     String?
  status          StatisticStatus @default(PUBLISHED)
  displayOrder    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, displayOrder])
}

model CompanyExpertise {
  id                 String   @id @default(uuid())
  topic              String   @unique
  description        String   @db.Text
  priority           Int      @default(1)
  active             Boolean  @default(true)
  displayOrder       Int      @default(0)
  relatedServices    String[]
  relatedProjects    String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, displayOrder])
}

model CompanyEvidence {
  id           String              @id @default(uuid())
  factId       String?
  fact         CompanyFact?        @relation(fields: [factId], references: [id], onDelete: Cascade)
  evidenceUrl  String
  evidenceType String              @default("Official Website")
  description  String?             @db.Text
  evidenceDate DateTime?           @default(now())
  status       FactVerifiedStatus  @default(VERIFIED)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
}

model SeoAuditIssue {
  id             String        @id @default(uuid())
  severity       AuditSeverity @default(WARNING)
  category       String
  issue          String
  recommendation String
  pageRoute      String?
  status         String        @default("OPEN")
  createdAt      DateTime      @default(now())

  @@index([status, severity])
}

// ==========================================
// ABOUT PAGE CMS MODULE
// ==========================================

model AboutPage {
  id                    String          @id @default(uuid())
  slug                  String          @unique @default("about")
  
  // Hero Section
  heroLabel             String          @default("ABOUT RYZITE")
  heroTitle             String          @default("Building Digital Solutions That Move Businesses Forward")
  heroDescription       String          @db.Text
  heroImageUrl          String?
  heroImagePublicId     String?
  heroImageAlt          String?
  heroCtaText           String?         @default("Book Discovery Session")
  heroCtaUrl            String?         @default("/#contact")
  heroActive            Boolean         @default(true)

  // Company Introduction
  introTitle            String          @default("Engineering Precision Meets Product Mastery")
  introShort            String          @db.Text
  introFull             String          @db.Text
  introActive           Boolean         @default(true)

  // Who We Are & Mission / Vision
  whoWeAreTitle         String          @default("Who We Are")
  whoWeAreDescription   String          @db.Text
  whoWeAreImageUrl      String?
  whoWeAreImagePublicId String?
  whoWeAreImageAlt      String?
  whoWeAreActive        Boolean         @default(true)

  missionTitle          String          @default("Our Mission")
  missionDescription    String          @db.Text
  missionImageUrl       String?
  missionImagePublicId  String?
  missionImageAlt       String?
  missionActive         Boolean         @default(true)

  visionTitle           String          @default("Our Vision")
  visionDescription     String          @db.Text
  visionImageUrl        String?
  visionImagePublicId   String?
  visionImageAlt        String?
  visionActive          Boolean         @default(true)

