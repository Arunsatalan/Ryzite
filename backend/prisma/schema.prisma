  showTrustedClients    Boolean         @default(true)
  useGlobalWhyChooseUs  Boolean         @default(true)
  showStatistics        Boolean         @default(true)
  showCapabilities      Boolean         @default(true)
  showTeam              Boolean         @default(true)
  showTimeline          Boolean         @default(true)
