  relatedFaqsTo      FaqRelationItem[]    @relation("TargetFaq")
  feedback           FaqFeedback[]
  versions           FaqVersion[]

  @@index([status, displayOrder])
  @@index([status, featured, displayOrder])
  @@index([categoryId, status])
  @@index([faqType, status])
}

model FaqServiceRelation {
  faqId        String
  faq          FaqItem  @relation(fields: [faqId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)

  @@id([faqId, serviceId])
  @@index([serviceId])
}

model FaqProjectRelation {
  faqId        String
  faq          FaqItem  @relation(fields: [faqId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)

  @@id([faqId, projectId])
  @@index([projectId])
}

model FaqRelationItem {
  faqId        String
  faq          FaqItem  @relation("SourceFaq", fields: [faqId], references: [id], onDelete: Cascade)
  relatedFaqId String
  relatedFaq   FaqItem  @relation("TargetFaq", fields: [relatedFaqId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)

  @@id([faqId, relatedFaqId])
}

model FaqFeedback {
  id        String   @id @default(uuid())
  faqId     String
  faq       FaqItem  @relation(fields: [faqId], references: [id], onDelete: Cascade)
  sessionId String
  helpful   Boolean
  createdAt DateTime @default(now())

  @@index([faqId, createdAt])
}

model FaqSearchLog {
  id             String   @id @default(uuid())
  searchQuery    String
  resultCount    Int      @default(0)
  selectedFaqId  String?
  createdAt      DateTime @default(now())

  @@index([searchQuery])
  @@index([createdAt])
}

model FaqVersion {
  id               String   @id @default(uuid())
  faqId            String
  faq              FaqItem  @relation(fields: [faqId], references: [id], onDelete: Cascade)
  question         String
  shortAnswer      String   @db.Text
  answerContent    String   @db.Text
  categoryId       String?
  metadataSnapshot Json?
  changedBy        String?
  changeReason     String?
  createdAt        DateTime @default(now())

  @@index([faqId, createdAt])
}

model Faq {
  id           String        @id @default(uuid())
  question     String
  answer       String        @db.Text
  enabled      Boolean       @default(true)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  serviceFaqs  ServiceFaq[]
  solutionFaqs SolutionFaq[]
  homeFaqs     HomeFaq[]

  @@index([enabled, displayOrder])
}

model ServiceFaq {
  serviceId    String
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  faqId        String
  faq          Faq     @relation(fields: [faqId], references: [id], onDelete: Cascade)
  displayOrder Int     @default(0)

  @@id([serviceId, faqId])
  @@index([serviceId, displayOrder])
}

model SolutionFaq {
  solutionId   String
  solution     Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  faqId        String
  faq          Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)

  @@id([solutionId, faqId])
  @@index([solutionId, displayOrder])
}

model HomeFaq {
  homePageId   String
  homePage     HomePage @relation(fields: [homePageId], references: [id], onDelete: Cascade)
  faqId        String
  faq          Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)

  @@id([homePageId, faqId])
  @@index([homePageId, displayOrder])
}

// ==========================================
