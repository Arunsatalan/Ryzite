// Prisma Schema for Ryzite Software Development & Digital Marketing Agency
// Database: PostgreSQL
// Version: Production Architecture Phase 2 Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_DISCUSSION
  PROPOSAL_SENT
  WON
  LOST
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum StatisticStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum FaqType {
  GENERAL
  SERVICE
  PRODUCT
  PROJECT
  TECHNICAL
  PRICING
  PROCESS
  SECURITY
  COMPANY
  SUPPORT
}

enum ServiceCategory {
  WEB_DEV
  MOBILE_DEV
  AI_AUTOMATION
  CLOUD_DEVOPS
  CONSULTING
}

enum ProjectMockupType {
  DARK_DASHBOARD
  MOBILE_CARDS
  BOT_INTERFACE
  ANALYTICS_SUITE
}

enum SectionKey {
  HERO
  CLIENTS
  SERVICES
  WHY_CHOOSE_US
  STATS
  PORTFOLIO
  AEO
  ABOUT
  CTA
  FAQ
  BLOG
  FINAL_CTA
}

enum MenuKey {
  HEADER
  FOOTER_COMPANY
  FOOTER_SERVICES
  FOOTER_LEGAL
}

// ==========================================
// ADMIN USER & AUDIT
// ==========================================

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String
  passwordHash String
  role         Role        @default(ADMIN)
  avatar       String?
  lastLogin    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  blogPosts    BlogPost[]
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId, createdAt])
}

// ==========================================
// SITE SETTINGS & SOCIAL LINKS
// ==========================================

model SiteSettings {
  id              String       @id @default(uuid())
  siteName        String       @default("Ryzite Software & AI Agency")
  legalName       String       @default("Ryzite Global Inc.")
  tagline         String       @default("We Build Software That Drives Growth")
  siteUrl         String       @default("https://ryzite.com")
  contactEmail    String       @default("contact@ryzite.com")
  phone           String       @default("+1-800-555-0199")
  whatsapp        String?
  addressLine1    String       @default("100 Innovation Way")
  addressLine2    String?      @default("Suite 400")
  city            String       @default("San Francisco")
  region          String       @default("CA")
  country         String       @default("USA")
  postalCode      String       @default("94105")
  businessHours   String       @default("Mon - Fri: 9:00 AM - 6:00 PM PST")
  defaultCtaLabel String       @default("Book Discovery Call")
  defaultCtaUrl   String       @default("#contact")
  defaultOgImage  MediaAsset?  @relation("DefaultOgImage", fields: [defaultOgImageId], references: [id], onDelete: SetNull)
  defaultOgImageId String?
  logo            MediaAsset?  @relation("LogoAsset", fields: [logoId], references: [id], onDelete: SetNull)
  logoId          String?
  darkLogo        MediaAsset?  @relation("DarkLogoAsset", fields: [darkLogoId], references: [id], onDelete: SetNull)
  darkLogoId      String?
  socialLinks     SocialLink[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model SocialLink {
  id             String       @id @default(uuid())
  platform       String
  label          String
  url            String
  iconKey        String
  displayOrder   Int          @default(0)
  enabled        Boolean      @default(true)
  siteSettingsId String
  siteSettings   SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)

  @@index([siteSettingsId, enabled, displayOrder])
}

// ==========================================
// MEDIA ASSETS
// ==========================================

model MediaAsset {
  id               String       @id @default(uuid())
  filename         String
  originalFilename String
  storageKey       String
  url              String
  publicId         String?
  mimeType         String
  width            Int?
  height           Int?
  fileSize         Int?
  altText          String?
  title            String?
  caption          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  siteSettingsOg   SiteSettings[] @relation("DefaultOgImage")
  siteSettingsLogo SiteSettings[] @relation("LogoAsset")
  siteSettingsDark SiteSettings[] @relation("DarkLogoAsset")
  homePageHero     HomePage[]     @relation("HomePageHeroImage")
  servicesHero     Service[]      @relation("ServiceHeroImage")
  solutionsHero    Solution[]     @relation("SolutionHeroImage")
  projectsHero     Project[]      @relation("ProjectHeroImage")
  projectMedia     ProjectMedia[]
  blogCover        BlogPost[]     @relation("BlogCoverImage")
  authorAvatars    Author[]       @relation("AuthorAvatar")
  clientsLogo      Client[]       @relation("ClientLogo")
}

// ==========================================
// HOME PAGE & SECTION SETTINGS
// ==========================================

model HomePage {
  id                      String        @id @default(uuid())
  heroBadgeText           String?       @default("SOFTWARE SOLUTIONS THAT SCALE")
  heroHeadingPrefix       String        @default("We Build Software")
  heroHeadingHighlight    String?       @default("Drives Growth")
  heroHeadingSuffix       String?       @default("")
  heroDescription         String        @db.Text
  heroPrimaryCtaText      String?       @default("Explore Our Services")
  heroPrimaryCtaUrl       String?       @default("/services")
  heroPrimaryCtaEnabled   Boolean       @default(true)
  heroPrimaryCtaOpenNewTab Boolean      @default(false)
  heroSecondaryCtaText    String?       @default("Book a Free Consultation")
  heroSecondaryCtaUrl     String?       @default("#contact")
  heroSecondaryCtaType    String?       @default("consultation")
  heroSecondaryCtaEnabled Boolean       @default(true)
  heroSecondaryCtaOpenNewTab Boolean    @default(false)
  heroBackgroundImageUrl  String?
  heroBackgroundImageAlt  String?
  heroImageUrl            String?
  heroImagePublicId       String?
  heroEnabled             Boolean       @default(true)
  heroDisplayOrder        Int           @default(1)
  
  // Legacy fields retained for safety
  heroEyebrow             String        @default("NEXT-GEN SOFTWARE & AI AGENCY")
  heroTitle               String        @default("We Build Software That Drives Growth")
  heroHighlightedText     String        @default("Drives Growth")
  primaryCtaLabel         String        @default("Schedule Architecture Call")
  primaryCtaUrl           String        @default("#contact")
  secondaryCtaLabel       String        @default("Explore Services")
  secondaryCtaUrl         String        @default("#services")
  heroImage               MediaAsset?   @relation("HomePageHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  heroImageId             String?
  servicesEyebrow     String        @default("OUR CAPABILITIES")
  servicesTitle       String        @default("Engineering Excellence Across the Stack")
  servicesDescription String        @db.Text
  portfolioEyebrow    String        @default("PROVEN OUTCOMES")
  portfolioTitle      String        @default("Case Studies & Client Results")
  portfolioDescription String       @db.Text
  aboutEyebrow        String        @default("WHY RYZITE")
  aboutTitle          String        @default("Architected for Speed & Reliability")
  aboutDescription    String        @db.Text
  faqEyebrow          String        @default("FREQUENTLY ASKED QUESTIONS")
  faqTitle            String        @default("Everything You Need to Know")
  faqDescription      String        @db.Text
  blogEyebrow         String        @default("ENGINEERING INSIGHTS")
  blogTitle           String        @default("Latest Tech & AEO Architecture")
  blogDescription     String        @db.Text
  finalCtaEyebrow     String        @default("READY TO BUILD?")
  finalCtaTitle       String        @default("Let's Architect Your Next Solution")
  finalCtaDescription String        @db.Text
  finalCtaLabel       String        @default("Get Free Scope Estimate")
  finalCtaUrl         String        @default("#contact")
  sections            HomeSection[]
  homeFaqs            HomeFaq[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model HomeSection {
  id           String     @id @default(uuid())
  homePageId   String
  homePage     HomePage   @relation(fields: [homePageId], references: [id], onDelete: Cascade)
  sectionKey   SectionKey
  enabled      Boolean    @default(true)
  displayOrder Int        @default(0)

  @@unique([homePageId, sectionKey])
  @@index([homePageId, enabled, displayOrder])
}

model Client {
  id           String      @id @default(uuid())
  name         String
  slug         String      @unique
  companyName  String?
  websiteUrl   String?
  logoId       String?
  logo         MediaAsset? @relation("ClientLogo", fields: [logoId], references: [id], onDelete: SetNull)
  logoUrl      String?
  logoPublicId String?
  logoAltText  String?
  description  String?
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  caseStudySlug String?
  featured     Boolean     @default(true)
  enabled      Boolean     @default(true)
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([enabled, displayOrder])
}

model CompanyPrinciple {
  id           String   @id @default(uuid())
  badge        String
  title        String
  description  String   @db.Text
  iconKey      String
  backgroundImageUrl      String?
  backgroundImagePublicId String?
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled, displayOrder])
}

model Statistic {
  id             String   @id @default(uuid())
  value          String
  label          String
  supportingText String?
  iconKey        String
  enabled        Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled, displayOrder])
}

model CompanyStatistic {
  id               String          @id @default(cuid())
  value            String
  prefix           String?
  suffix           String?
  label            String
  description      String?
  iconName         String?
  iconColor        String?
  animationEnabled Boolean         @default(true)
  displayOrder     Int             @default(0)
  status           StatisticStatus @default(PUBLISHED)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, displayOrder])
}

// ==========================================
// MASTER TECHNOLOGIES
// ==========================================

model Technology {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  iconUrl    String?
  iconKey    String?
  websiteUrl String?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  serviceTechnologies  ServiceTechnology[]
  solutionTechnologies SolutionTechnology[]
  projectTechnologies  ProjectTechnology[]
}

// ==========================================
// SERVICES
// ==========================================

model Service {
  id               String               @id @default(uuid())
  slug             String               @unique
  title            String
  category         ServiceCategory
  categoryName     String?
  shortDescription String
  fullDescription  String               @db.Text
  iconName         String
  timeline         String
  startingPrice    String
  heroImageId      String?
  heroImage        MediaAsset?          @relation("ServiceHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  heroImageUrl     String?
  imageUrl         String?
  imagePublicId    String?
  imageAlt         String?
  status           ContentStatus        @default(PUBLISHED)
  active           Boolean              @default(true)
  featured         Boolean              @default(true)
  displayOrder     Int                  @default(0)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  publishedAt      DateTime             @default(now())

  features         ServiceFeature[]
  deliverables     ServiceDeliverable[]
  technologies     ServiceTechnology[]
  solutions        SolutionService[]
  projects         ProjectService[]
  faqItemServices  FaqServiceRelation[]
  blogItemServices BlogServiceRelation[]
  serviceFaqs      ServiceFaq[]
  leads            Lead[]
  seoMetadata      SeoMetadata?

  @@index([status, displayOrder])
  @@index([status, featured, displayOrder])
}

model ServiceFeature {
  id           String   @id @default(uuid())
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title        String
  description  String?  @db.Text
  iconKey      String?
  displayOrder Int      @default(0)

  @@index([serviceId, displayOrder])
}

model ServiceDeliverable {
  id           String   @id @default(uuid())
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title        String
  description  String?  @db.Text
  displayOrder Int      @default(0)

  @@index([serviceId, displayOrder])
}

model ServiceTechnology {
  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  displayOrder Int        @default(0)

  @@id([serviceId, technologyId])
  @@index([serviceId, displayOrder])
}

// ==========================================
// SOLUTIONS
// ==========================================

model Solution {
  id               String               @id @default(uuid())
  slug             String               @unique
  title            String
  subtitle         String?
  category         String
  shortDescription String
  fullDescription  String               @db.Text
  problem          String?              @db.Text
  solution         String?              @db.Text
  iconKey          String
  heroImageId      String?
  heroImage        MediaAsset?          @relation("SolutionHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  status           ContentStatus        @default(PUBLISHED)
  featured         Boolean              @default(true)
  displayOrder     Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  publishedAt      DateTime             @default(now())

  benefits         SolutionBenefit[]
  services         SolutionService[]
  technologies     SolutionTechnology[]
  solutionFaqs     SolutionFaq[]
  seoMetadata      SeoMetadata?

  @@index([status, displayOrder])
  @@index([status, featured, displayOrder])
}

model SolutionBenefit {
  id           String   @id @default(uuid())
  solutionId   String
  solution     Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  title        String
  description  String?  @db.Text
  iconKey      String?
  displayOrder Int      @default(0)

  @@index([solutionId, displayOrder])
}

model SolutionService {
  solutionId   String
  solution     Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)

  @@id([solutionId, serviceId])
  @@index([solutionId, displayOrder])
  @@index([serviceId])
}

model SolutionTechnology {
  solutionId   String
  solution     Solution   @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  displayOrder Int        @default(0)

  @@id([solutionId, technologyId])
  @@index([solutionId, displayOrder])
}

// ==========================================
// PROJECTS / CASE STUDIES
// ==========================================

model ProjectCategory {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  displayOrder Int       @default(0)
  enabled      Boolean   @default(true)
  projects     Project[]
}

model Project {
  id                        String            @id @default(uuid())
  slug                      String            @unique
  title                     String
  heroTitle                 String?
  subtitle                  String?
  clientName                String
  clientLogoUrl             String?
  clientLogoPublicId        String?
  clientWebsiteUrl          String?
  categoryId                String?
  categoryRef               ProjectCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  category                  String            // Legacy string fallback
  shortDescription          String
  fullDescription           String            @db.Text
  challenge                 String?           @db.Text
  solution                  String?           @db.Text
  results                   String?           @db.Text
  businessImpactText        String?           @db.Text
  heroImageId               String?
  heroImageRef              MediaAsset?       @relation("ProjectHeroImage", fields: [heroImageId], references: [id], onDelete: SetNull)
  heroImage                 String            // Fallback URL string
  heroImagePublicId         String?
  coverImageUrl             String?
  coverImagePublicId        String?
  architectureDiagramUrl    String?
  architectureDiagramPublicId String?
  liveUrl                   String?
  ctaText                   String?           @default("Visit Live Platform Demo")
  ctaLink                   String?
  galleryImages             Json?             // Array of { url, publicId, caption, order }
  mockupType                ProjectMockupType @default(DARK_DASHBOARD)
  testimonial               Json?             // { quote, author, role, company, photoUrl, photoPublicId }
  websiteUrl                String?
  githubUrl                 String?
  status                    ContentStatus     @default(PUBLISHED)
  featured                  Boolean           @default(true)
  displayOrder              Int               @default(0)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  publishedAt               DateTime          @default(now())

  metrics                   ProjectMetric[]
  highlights                ProjectHighlight[]
  challengesList            ProjectChallenge[]
  solutionsList             ProjectSolution[]
  resultsList               ProjectResult[]
  mediaGallery              ProjectMedia[]
  services                  ProjectService[]
  technologies              ProjectTechnology[]
  faqItemProjects           FaqProjectRelation[]
  blogItemProjects          BlogProjectRelation[]
  clients                   Client[]
  seoMetadata               SeoMetadata?

  @@index([status, featured, displayOrder])
  @@index([status, publishedAt])
}

model ProjectMetric {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label        String
  value        String
  trend        String?
  description  String?
  icon         String?  @default("TrendingUp")
  displayOrder Int      @default(0)

  @@index([projectId, displayOrder])
}

model ProjectChallenge {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?  @db.Text
  icon         String?  @default("AlertTriangle")
  displayOrder Int      @default(0)

  @@index([projectId, displayOrder])
}

model ProjectSolution {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?  @db.Text
  icon         String?  @default("CheckCircle2")
  displayOrder Int      @default(0)

  @@index([projectId, displayOrder])
}

model ProjectResult {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  beforeText   String   @db.Text
  afterText    String   @db.Text
  displayOrder Int      @default(0)

  @@index([projectId, displayOrder])
}

model ProjectHighlight {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?  @db.Text
  displayOrder Int      @default(0)

  @@index([projectId, displayOrder])
}

model ProjectMedia {
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId      String
  media        MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption      String?
  displayOrder Int        @default(0)

  @@id([projectId, mediaId])
  @@index([projectId, displayOrder])
}

model ProjectService {
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId    String
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  displayOrder Int     @default(0)

  @@id([projectId, serviceId])
  @@index([projectId, displayOrder])
}

model ProjectTechnology {
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)
  displayOrder Int        @default(0)

  @@id([projectId, technologyId])
  @@index([projectId, displayOrder])
}

// ==========================================
// BLOG ECOSYSTEM
// ==========================================

model Author {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  bio         String?     @db.Text
  role        String?
  avatarId    String?
  avatarRef   MediaAsset? @relation("AuthorAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  avatarUrl   String?
  avatarPublicId String?
  email       String?
  linkedinUrl String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  blogPosts   BlogPost[]
}

enum BlogPostStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum BlogPostType {
  ARTICLE
  GUIDE
  HOW_TO
  TUTORIAL
  NEWS
  CASE_STUDY
  TECHNICAL
  OPINION
  REPORT
  ANNOUNCEMENT
  RESEARCH
}

enum SearchIntent {
  INFORMATIONAL
  COMMERCIAL
  TRANSACTIONAL
  NAVIGATIONAL
  COMPARISON
  HOW_TO
}

model BlogCategory {
  id             String     @id @default(uuid())
  name           String
  slug           String     @unique
  description    String?    @db.Text
  icon           String?    @default("Sparkles")
  seoTitle       String?
  seoDescription String?
  displayOrder   Int        @default(0)
  isActive       Boolean    @default(true)
  blogPosts      BlogPost[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model BlogAuthor {
  id                   String     @id @default(uuid())
  name                 String
  slug                 String     @unique
  jobTitle             String
  bio                  String     @db.Text
  profileImageUrl      String?
  profileImagePublicId String?
  linkedInUrl          String?
  websiteUrl           String?
  expertise            String?
  isActive             Boolean    @default(true)
  blogPosts            BlogPost[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model ContentCluster {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String?    @db.Text
  pillarPostId String?
  status       String     @default("ACTIVE")
  blogPosts    BlogPost[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model BlogPost {
  id                 String          @id @default(uuid())
  slug               String          @unique
  title              String
  excerpt            String          @db.Text
  content            String          @db.Text
  plainTextContent   String?         @db.Text
  status             BlogPostStatus  @default(PUBLISHED)
  postType           BlogPostType    @default(ARTICLE)
  categoryId         String?
  category           BlogCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId           String?
  author             BlogAuthor?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  featured           Boolean         @default(false)
  featuredOrder      Int             @default(0)
  displayOrder       Int             @default(0)
  publishedAt        DateTime        @default(now())
  scheduledAt        DateTime?
  updatedAt          DateTime        @updatedAt
  createdAt          DateTime        @default(now())
  lastReviewedAt     DateTime?
  reviewDueAt        DateTime?
  readingTimeMinutes Int             @default(5)
  wordCount          Int             @default(0)

  // Cover image
  coverImageUrl      String?
  coverImagePublicId String?
  coverImageAlt      String?
  coverImageWidth    Int?
  coverImageHeight   Int?

  // OG image
  ogImageUrl         String?
  ogImagePublicId    String?

  // SEO & AEO
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  robotsIndex        Boolean         @default(true)
  robotsFollow       Boolean         @default(true)
  focusKeyword       String?
  secondaryKeywords  String?
  searchIntent       SearchIntent    @default(INFORMATIONAL)
  pillarId           String?
  contentClusterId   String?
  contentCluster     ContentCluster? @relation(fields: [contentClusterId], references: [id], onDelete: SetNull)
  sourceUrl          String?
  sourceName         String?
  isOriginal         Boolean         @default(true)
  directAnswer       String?         @db.Text
  keyTakeaways       String?         @db.Text
  qualityScore       Int             @default(90)

  // Analytics
  views              Int             @default(0)
  reads              Int             @default(0)
  createdBy          String?
  updatedBy          String?

  // Relations & legacy fallbacks
  featuredImageId    String?
  featuredImage      MediaAsset?     @relation("BlogCoverImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  userId             String?
  userRef            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  legacyAuthorId     String?
  authorRef          Author?         @relation(fields: [legacyAuthorId], references: [id], onDelete: SetNull)
  tags               BlogPostTag[]
  services           BlogServiceRelation[]
  projects           BlogProjectRelation[]
  faqs               BlogFaqRelation[]
  relatedFrom        RelatedBlogPost[] @relation("BlogSourcePost")
  relatedTo          RelatedBlogPost[] @relation("BlogTargetPost")
  versions           BlogPostVersion[]
  seoMetadata        SeoMetadata?

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([authorId, status, publishedAt])
  @@index([status, featured, publishedAt])
}

model BlogTag {
