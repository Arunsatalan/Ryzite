  tagId  String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model BlogServiceRelation {
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([postId, serviceId])
}

model BlogProjectRelation {
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([postId, projectId])
}

model BlogFaqRelation {
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  faqId  String
  faq    FaqItem  @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@id([postId, faqId])
}

model RelatedBlogPost {
  postId        String
  post          BlogPost @relation("BlogSourcePost", fields: [postId], references: [id], onDelete: Cascade)
  relatedPostId String
  relatedPost   BlogPost @relation("BlogTargetPost", fields: [relatedPostId], references: [id], onDelete: Cascade)
  displayOrder  Int      @default(0)

  @@id([postId, relatedPostId])
}

model BlogPostVersion {
  id        String   @id @default(uuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  snapshot  Json
  changedBy String   @default("Admin")
  reason    String?
  createdAt DateTime @default(now())
}

model BlogSearchLog {
  id           String   @id @default(uuid())
  query        String
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model BlogRedirect {
  id         String   @id @default(uuid())
  oldPath    String   @unique
  newPath    String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())
}

// ==========================================
// FAQ REPOSITORY
// ==========================================

model FaqCategory {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  icon         String?   @default("HelpCircle")
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  faqs         FaqItem[]

  @@index([isActive, displayOrder])
}

model FaqItem {
  id                 String               @id @default(uuid())
  question           String
  slug               String               @unique
  shortAnswer        String               @db.Text
  answerContent      String               @db.Text
  plainTextAnswer    String?              @db.Text
  categoryId         String?
  category           FaqCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  faqType            FaqType              @default(GENERAL)
  status             ContentStatus        @default(PUBLISHED)
  displayOrder       Int                  @default(0)
  featured           Boolean              @default(false)
  isGlobal           Boolean              @default(true)
  indexable          Boolean              @default(true)
  views              Int                  @default(0)
  expands            Int                  @default(0)
  helpfulCount       Int                  @default(0)
  notHelpfulCount    Int                  @default(0)
  qualityScore       Int                  @default(90)
  imageUrl           String?
  imagePublicId      String?
  imageAlt           String?
  imageWidth         Int?
  imageHeight        Int?
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  ogTitle            String?
  ogDescription      String?
  ogImageUrl         String?
  ogImagePublicId    String?
  sourceType         String?              @default("Company Documentation")
  sourceUrl          String?
  sourceNote         String?
  lastReviewedAt     DateTime             @default(now())
  reviewDueAt        DateTime?
  publishedAt        DateTime             @default(now())
  createdBy          String?
  updatedBy          String?
  authorId           String?
  reviewerId         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  services           FaqServiceRelation[]
  projects           FaqProjectRelation[]
  blogPosts          BlogFaqRelation[]
