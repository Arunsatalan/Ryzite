  canonicalUrl          String          @default("https://ryzite.com/about")
  ogTitle               String?
  ogDescription         String?         @db.Text
  ogImageUrl            String?
  ogImagePublicId       String?
  robotsIndex           Boolean         @default(true)
  robotsFollow          Boolean         @default(true)
  focusTopic            String?         @default("Software Development Agency Identity")

