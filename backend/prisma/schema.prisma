  ctaTitle              String          @default("Ready to Build With Senior Architects?")
  ctaDescription        String          @db.Text
  ctaButtonText         String          @default("Start a Project")
  ctaButtonUrl          String          @default("/#contact")
  ctaSecondaryText      String?         @default("View Portfolio")
  ctaSecondaryUrl       String?         @default("/portfolio")
  ctaActive             Boolean         @default(true)

