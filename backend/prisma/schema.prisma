model AboutIndustry {
  id              String    @id @default(uuid())
  aboutPageId     String
  aboutPage       AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)
  industry        String
  description     String    @db.Text
  icon            String    @default("Building2")
  relatedServices String[]
  displayOrder    Int       @default(0)
  active          Boolean   @default(true)

  @@index([aboutPageId, displayOrder])
}

model AboutPageVersion {
  id          String    @id @default(uuid())
  aboutPageId String
  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)
  snapshot    Json
  changedBy   String    @default("Admin System")
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([aboutPageId, createdAt])
}

// ==========================================
// TECHNICAL LEADERSHIP TEAM CMS MODULE
// ==========================================

model TechnicalLeadershipTeamMember {
  id                   String          @id @default(uuid())
  name                 String
  slug                 String          @unique
  title                String
  shortBio             String          @db.Text
  longBio              String?         @db.Text
  profileImageUrl      String
  profileImagePublicId String
  profileImageAlt      String
  profileImageWidth    Int?
  profileImageHeight   Int?
  expertise            String[]        @default([])
  technologies         String[]        @default([])
  linkedinUrl          String?
  githubUrl            String?
  displayOrder         Int             @default(0)
  status               StatisticStatus @default(PUBLISHED)
  isActive             Boolean         @default(true)
  publishedAt          DateTime?       @default(now())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status, isActive, displayOrder])
}



// ==========================================
// FINAL CTA / CONVERSION ENGINE
// ==========================================

model FinalCta {
  id                             String               @id @default(uuid())
  name                           String
  eyebrow                        String?
  headline                       String
  highlightedText                String?
  description                    String?              @db.Text
  supportingText                 String?              @db.Text
  primaryLabel                   String
  primaryActionType              String               @default("CONTACT_FORM")
  primaryActionUrl               String?
  secondaryLabel                 String?
  secondaryActionType            String?              @default("PORTFOLIO_PAGE")
  secondaryActionUrl             String?
  tertiaryLabel                  String?
  tertiaryActionType             String?              @default("BOOK_CALL")
  tertiaryActionUrl              String?
  variant                        String               @default("DEFAULT")
  theme                          String               @default("DARK")
  backgroundType                 String               @default("DARK")
  backgroundImageUrl             String?
  backgroundImagePublicId        String?
  backgroundImageAlt             String?
  mobileBackgroundImageUrl       String?
  mobileBackgroundImagePublicId String?
  overlayEnabled                 Boolean              @default(true)
  overlayOpacity                 Float                @default(0.8)
  showTrustLine                  Boolean              @default(true)
  showTertiaryAction             Boolean              @default(false)
  showContactInfo                Boolean              @default(false)
  contactEmail                   String?
  contactPhone                   String?
  showTrustedClients             Boolean              @default(false)
  showCaseStudies                Boolean              @default(false)
  isActive                       Boolean              @default(true)
  isGlobal                       Boolean              @default(false)
  priority                       Int                  @default(0)
  status                         String               @default("ACTIVE")
  startAt                        DateTime?
  endAt                          DateTime?
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt
  createdBy                      String?
  updatedBy                      String?

  overrides                      FinalCtaOverride[]
  analyticsEvents                CtaAnalyticsEvent[]
  leadTouchpoints                LeadTouchpoint[]
  leadsGenerated                 Lead[]               @relation("LeadSourceCta")
  versions                       FinalCtaVersion[]
  experimentsA                   CtaExperiment[]      @relation("ExperimentCtaA")
  experimentsB                   CtaExperiment[]      @relation("ExperimentCtaB")

  @@index([status, isActive, priority])
  @@index([isGlobal, isActive])
}

model FinalCtaOverride {
  id        String   @id @default(uuid())
  ctaId     String
  cta       FinalCta @relation(fields: [ctaId], references: [id], onDelete: Cascade)
  pageType  String
  pageId    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageType, pageId, isActive])
}

model CtaAnalyticsEvent {
  id          String   @id @default(uuid())
  ctaId       String
  cta         FinalCta @relation(fields: [ctaId], references: [id], onDelete: Cascade)
  eventType   String
  pageUrl     String
  pageType    String?
  pageId      String?
  sessionId   String?
  deviceType  String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  timestamp   DateTime @default(now())

  @@index([ctaId, eventType, timestamp])
  @@index([pageType, timestamp])
}

model LeadTouchpoint {
  id        String    @id @default(uuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ctaId     String?
  cta       FinalCta? @relation(fields: [ctaId], references: [id], onDelete: SetNull)
  pageUrl   String
  eventType String
  timestamp DateTime  @default(now())

  @@index([leadId, timestamp])
}

model CtaExperiment {
  id                String   @id @default(uuid())
  name              String
  ctaAId            String
  ctaA              FinalCta @relation("ExperimentCtaA", fields: [ctaAId], references: [id], onDelete: Cascade)
  ctaBId            String
  ctaB              FinalCta @relation("ExperimentCtaB", fields: [ctaBId], references: [id], onDelete: Cascade)
  trafficPercentage Int      @default(50)
  status            String   @default("DRAFT")
  startAt           DateTime?
  endAt             DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model FinalCtaVersion {
  id           String   @id @default(uuid())
  ctaId        String
  cta          FinalCta @relation(fields: [ctaId], references: [id], onDelete: Cascade)
  snapshot     Json
  changedBy    String   @default("Admin")
  changeReason String?
  createdAt    DateTime @default(now())

  @@index([ctaId, createdAt])
}



